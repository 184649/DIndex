<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DIndex</AssemblyName>
    <RootNamespace>DIndex</RootNamespace>
    <Version>1.1.0-preview.1</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="DIndex.AppIcon" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\UpdatePackageSafety.cs" Link="UpdatePackageSafety.cs" />
    <Compile Include="..\Shared\InstallationMode.cs" Link="InstallationMode.cs" />
  </ItemGroup>
</Project>


